<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agendamento - Salão de Beleza</title>
    <style>
        :root { --primary: #d42e61; --bg: #f8f9fa; --card: #ffffff; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); margin: 0; padding: 15px; color: #333; }
        .container { max-width: 500px; margin: 0 auto; background: var(--card); border-radius: 12px; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); }
        h2 { text-align: center; color: var(--primary); margin-top: 0; }
        .tabs { display: flex; border-bottom: 2px solid #eee; margin-bottom: 20px; }
        .tab-btn { flex: 1; padding: 10px; text-align: center; background: none; border: none; font-weight: bold; color: #666; cursor: pointer; border-bottom: 3px solid transparent; }
        .tab-btn.active { color: var(--primary); border-color: var(--primary); }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .form-group { margin-bottom: 15px; }
        label { display: block; font-weight: 600; margin-bottom: 5px; }
        input, select, button { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; }
        button.btn-primary { background: var(--primary); color: white; border: none; font-weight: bold; cursor: pointer; margin-top: 10px; font-size: 16px; }
        .service-item { display: flex; justify-content: space-between; align-items: center; padding: 10px; background: #f1f1f1; border-radius: 8px; margin-bottom: 8px; }
        .service-item button { width: auto; background: #ff4d4d; color: white; border: none; padding: 5px 10px; border-radius: 4px; }
    </style>
</head>
<body>

<div class="container">
    <h2>Agendamento de Serviços</h2>

    <!-- Abas -->
    <div class="tabs">
        <button class="tab-btn active" onclick="openTab('agendar')">Agendar</button>
        <button class="tab-btn" onclick="openTab('servicos')">Serviços (Admin)</button>
    </div>

    <!-- Aba 1: Agendar -->
    <div id="agendar" class="tab-content active">
        <form id="bookingForm" onsubmit="realizarAgendamento(event)">
            <div class="form-group">
                <label>Nome da Cliente:</label>
                <input type="text" id="clientName" required placeholder="Digite seu nome completo">
            </div>
            <div class="form-group">
                <label>Seu WhatsApp (com DDD):</label>
                <input type="tel" id="clientPhone" required placeholder="Ex: 21999999999">
            </div>
            <div class="form-group">
                <label>Selecione o Serviço:</label>
                <select id="serviceSelect" required onchange="updatePrice()"></select>
            </div>
            <div class="form-group">
                <label>Valor do Serviço:</label>
                <input type="text" id="servicePriceDisplay" readonly style="background: #e9ecef;">
            </div>
            <div class="form-group">
                <label>Data:</label>
                <input type="date" id="appointmentDate" required>
            </div>
            <div class="form-group">
                <label>Horário:</label>
                <input type="time" id="appointmentTime" required>
            </div>
            <button type="submit" class="btn-primary">Confirmar e Enviar via WhatsApp</button>
        </form>
    </div>

    <!-- Aba 2: Gestão de Serviços & Valores -->
    <div id="servicos" class="tab-content">
        <h3>Gerenciar Serviços e Valores</h3>
        <div class="form-group">
            <input type="text" id="newServiceName" placeholder="Nome do Serviço (ex: Corte + Escova)">
        </div>
        <div class="form-group">
            <input type="number" id="newServicePrice" placeholder="Preço (R$)">
        </div>
        <button onclick="addService()" class="btn-primary">Adicionar Serviço</button>

        <h4 style="margin-top: 20px;">Serviços Cadastrados:</h4>
        <div id="servicesList"></div>
    </div>
</div>

<script>
    // Inicialização do armazenamento local
    let services = JSON.parse(localStorage.getItem('salao_servicos')) || [
        { id: 1, name: 'Manicure e Pedicure', price: 60 },
        { id: 2, name: 'Design de Sobrancelhas', price: 45 }
    ];

    function saveServices() {
        localStorage.setItem('salao_servicos', JSON.stringify(services));
        renderServices();
    }

    function openTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
        document.getElementById(tabName).classList.add('active');
        event.currentTarget.classList.add('active');
    }

    function renderServices() {
        const listContainer = document.getElementById('servicesList');
        const selectContainer = document.getElementById('serviceSelect');
        listContainer.innerHTML = '';
        selectContainer.innerHTML = '<option value="">Selecione...</option>';

        services.forEach((s, index) => {
            // Render na lista de edição
            listContainer.innerHTML += `
                <div class="service-item">
                    <span><strong>${s.name}</strong> - R$ ${s.price.toFixed(2)}</span>
                    <button onclick="removeService(${index})">Excluir</button>
                </div>`;
            
            // Render no dropdown de agendamento
            selectContainer.innerHTML += `<option value="${s.price}">${s.name}</option>`;
        });
    }

    function addService() {
        const name = document.getElementById('newServiceName').value;
        const price = parseFloat(document.getElementById('newServicePrice').value);
        if (name && !isNaN(price)) {
            services.push({ id: Date.now(), name, price });
            saveServices();
            document.getElementById('newServiceName').value = '';
            document.getElementById('newServicePrice').value = '';
        }
    }

    function removeService(index) {
        services.splice(index, 1);
        saveServices();
    }

    function updatePrice() {
        const select = document.getElementById('serviceSelect');
        const price = select.value ? `R$ ${parseFloat(select.value).toFixed(2)}` : '';
        document.getElementById('servicePriceDisplay').value = price;
    }

    function realizarAgendamento(e) {
        e.preventDefault();
        const clientName = document.getElementById('clientName').value;
        const serviceSelect = document.getElementById('serviceSelect');
        const serviceName = serviceSelect.options[serviceSelect.selectedIndex].text;
        const price = document.getElementById('servicePriceDisplay').value;
        const date = document.getElementById('appointmentDate').value;
        const time = document.getElementById('appointmentTime').value;

        // Monta a mensagem enviada pelo WhatsApp
        const msg = `*Novo Agendamento Solicitado!*%0A%0A` +
                    `*Cliente:* ${clientName}%0A` +
                    `*Serviço:* ${serviceName}%0A` +
                    `*Valor:* ${price}%0A` +
                    `*Data:* ${date}%0A` +
                    `*Horário:* ${time}`;

        // Substitua pelo número de WhatsApp do seu salão com DDD (Ex: 5521999999999)
        const salaoWhatsapp = "5521999999999"; 
        
        window.open(`https://wa.me/${salaoWhatsapp}?text=${msg}`, '_blank');
    }

    // Carregar dados iniciais
    renderServices();
</script>
</body>
</html>
